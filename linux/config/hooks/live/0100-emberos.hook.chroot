#!/bin/sh
# Runs inside the image while it is being built: branding and desktop defaults.
set -e

# Name the OS (keep ID=debian so Debian tooling keeps working).
if [ -f /usr/lib/os-release ]; then
    sed -i \
        -e 's/^NAME=.*/NAME="EmberOS"/' \
        -e 's/^PRETTY_NAME=.*/PRETTY_NAME="EmberOS 0.1 (Debian 13 base)"/' \
        /usr/lib/os-release
fi
echo "EmberOS 0.1 \\n \\l" > /etc/issue
echo "EmberOS 0.1" > /etc/issue.net

# Installer launcher: hide Debian's own Calamares entries everywhere. The live
# session adds its own "Install EmberOS" launcher at login
# (/usr/local/bin/emberos-live-desktop), so an installed system never shows one.
chmod +x /usr/local/bin/emberos-live-desktop
grep -lE '^Exec=.*calamares' /usr/share/applications/*.desktop 2>/dev/null | while read -r f; do
    echo "NoDisplay=true" >> "$f"
done
rm -f /etc/skel/Desktop/*.desktop

# Calamares runs as root, which needs the X11 session (Wayland refuses root
# clients). X11 also behaves better in VMware.
if [ -f /etc/gdm3/daemon.conf ]; then
    if grep -q 'WaylandEnable' /etc/gdm3/daemon.conf; then
        sed -i 's/^#\?\s*WaylandEnable=.*/WaylandEnable=false/' /etc/gdm3/daemon.conf
    else
        sed -i '/^\[daemon\]/a WaylandEnable=false' /etc/gdm3/daemon.conf
    fi
fi

# Show fastfetch (with the EmberOS logo) when a terminal opens.
cat >> /etc/skel/.bashrc <<'EOF'

# EmberOS greeting: remove these lines if you do not want it
if [ -t 1 ] && command -v fastfetch >/dev/null 2>&1; then
    fastfetch
fi
EOF

# Compile the desktop defaults in /etc/dconf/db (colours, dock, wallpaper ...).
dconf update

# Boot splash / console branding is left at defaults for now.
exit 0
