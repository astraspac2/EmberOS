#!/bin/sh
# Runs inside the image while it is being built: branding and desktop defaults.
set -e

# Name the OS (keep ID=debian so Debian tooling keeps working).
if [ -f /usr/lib/os-release ]; then
    sed -i \
        -e 's/^NAME=.*/NAME="EmberOS"/' \
        -e 's/^PRETTY_NAME=.*/PRETTY_NAME="EmberOS 0.1 (Debian 13 base)"/' \
        /usr/lib/os-release
fi
echo "EmberOS 0.1 \\n \\l" > /etc/issue
echo "EmberOS 0.1" > /etc/issue.net

# Installer launcher: hide Debian's own Calamares entries everywhere. The live
# session adds its own "Install EmberOS" launcher at login
# (/usr/local/bin/emberos-session-setup), so an installed system never shows one.
chmod +x /usr/local/bin/emberos-session-setup /usr/local/bin/emberos-wallpaper /usr/local/bin/emberos-welcome

# Drop apps nobody asked for (PDF viewers, help browsers, extras that get
# pulled in as "recommends"). Firefox opens PDFs itself.
for p in evince evince-common papers atril okular yelp gnome-user-docs \
         totem cheese gnome-contacts gnome-calendar gnome-maps gnome-weather \
         simple-scan transmission-gtk hexchat thunderbird libreoffice-common; do
    if dpkg -s "$p" >/dev/null 2>&1; then
        apt-get purge -y "$p" || true
    fi
done
grep -lE '^Exec=.*calamares' /usr/share/applications/*.desktop 2>/dev/null | while read -r f; do
    echo "NoDisplay=true" >> "$f"
done
rm -f /etc/skel/Desktop/*.desktop

# Show fastfetch (with the EmberOS logo) when a terminal opens.
cat >> /etc/skel/.bashrc <<'EOF'

# EmberOS greeting: remove these lines if you do not want it
if [ -t 1 ] && command -v fastfetch >/dev/null 2>&1; then
    fastfetch
fi
EOF


# Firewall on by default (deny incoming, allow outgoing).
if [ -f /etc/ufw/ufw.conf ]; then
    sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
    sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' /etc/default/ufw
fi

# EmberOS boot splash (plymouth). Best effort: a miss must not fail the build.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme emberos || true
    update-initramfs -u || true
fi

# Trim the image: keep English and German texts, drop docs, man and info pages
# (the licence files stay, as Debian requires). Keeps the ISO under 2 GiB.
for d in /usr/share/locale/*; do
    case "$(basename "$d")" in
        en|en_*|de|de_*|locale.alias) ;;
        *) rm -rf "$d" ;;
    esac
done
find /usr/share/doc -type f ! -name copyright -delete 2>/dev/null || true
rm -rf /usr/share/man/* /usr/share/info/* /usr/share/help/* 2>/dev/null || true
apt-get clean
# Compile the desktop defaults in /etc/dconf/db (colours, wallpaper, terminal ...).
dconf update

# Boot splash / console branding is left at defaults for now.
exit 0
