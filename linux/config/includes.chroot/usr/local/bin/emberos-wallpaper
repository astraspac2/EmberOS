#!/usr/bin/env python3
"""EmberOS wallpaper chooser: click a picture to set it as the desktop wallpaper."""
import os
import subprocess

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GdkPixbuf, Gtk  # noqa: E402

DIR = "/usr/share/backgrounds/emberos"
# The first entry is the default every new user starts with.
WALLPAPERS = (
    ("Midnight (default)", "3-midnight.png"),
    ("Ember dusk", "2-ember-dusk.png"),
    ("Charcoal", "1-charcoal.png"),
    ("Black embers", "4-black-embers.png"),
)
THUMB_W, THUMB_H = 256, 144
SCHEMA = "org.gnome.desktop.background"


def gsettings(*args):
    return subprocess.run(["gsettings", *args], capture_output=True, text=True).stdout.strip()


def current_image():
    return gsettings("get", SCHEMA, "picture-uri").strip("'").replace("file://", "")


def apply(path):
    for key in ("picture-uri", "picture-uri-dark"):
        gsettings("set", SCHEMA, key, "file://" + path)
    gsettings("set", SCHEMA, "picture-options", "zoom")


class Chooser(Gtk.Window):
    def __init__(self):
        super().__init__(title="EmberOS Wallpapers")
        self.set_default_size(3 * (THUMB_W + 40) + 40, 420)
        self.set_border_width(12)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(box)
        box.pack_start(Gtk.Label(label="Click a wallpaper to use it.", xalign=0), False, False, 0)

        self.flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.SINGLE,
                                homogeneous=True, max_children_per_line=3,
                                row_spacing=10, column_spacing=10)
        self.flow.connect("child-activated", self.on_pick)
        scroller = Gtk.ScrolledWindow()
        scroller.add(self.flow)
        box.pack_start(scroller, True, True, 0)

        self.paths = {}
        now = current_image()
        for name, fname in WALLPAPERS:
            path = os.path.join(DIR, fname)
            if os.path.exists(path):
                self.add_item(name, path, now)

        buttons = Gtk.Box(spacing=8)
        other = Gtk.Button(label="Choose another picture…")
        other.connect("clicked", self.on_other)
        buttons.pack_start(other, False, False, 0)
        box.pack_start(buttons, False, False, 0)

    def add_item(self, name, path, now):
        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, THUMB_W, THUMB_H, True)
        item = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        item.pack_start(Gtk.Image.new_from_pixbuf(pix), False, False, 0)
        item.pack_start(Gtk.Label(label=name), False, False, 0)
        self.flow.add(item)
        child = item.get_parent()
        self.paths[child] = path
        if os.path.realpath(path) == os.path.realpath(now) or (
                name.endswith("(default)") and os.path.basename(now) == "emberos-wallpaper.png"):
            self.flow.select_child(child)

    def on_pick(self, _flow, child):
        apply(self.paths[child])

    def on_other(self, _button):
        dialog = Gtk.FileChooserDialog(title="Choose a picture", parent=self,
                                       action=Gtk.FileChooserAction.OPEN)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Use as wallpaper", Gtk.ResponseType.OK)
        images = Gtk.FileFilter()
        images.set_name("Pictures")
        images.add_mime_type("image/png")
        images.add_mime_type("image/jpeg")
        dialog.add_filter(images)
        if dialog.run() == Gtk.ResponseType.OK:
            apply(dialog.get_filename())
            self.flow.unselect_all()
        dialog.destroy()


if __name__ == "__main__":
    win = Chooser()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
