#!/bin/sh
# Live session only: give the live user an "Install EmberOS" launcher and pin it
# first in the dock. Installed systems have no "boot=live" on their kernel
# command line, so they never get it.
grep -qw 'boot=live' /proc/cmdline || exit 0

APPS="$HOME/.local/share/applications"
ID=install-emberos.desktop
mkdir -p "$APPS"

cat > "$APPS/$ID" <<EOF
[Desktop Entry]
Type=Application
Name=Install EmberOS
Comment=Install EmberOS to your computer
Exec=sudo -E calamares
Icon=/usr/share/pixmaps/emberos-install.png
Terminal=false
Categories=System;
StartupNotify=true
EOF

cur=$(gsettings get org.gnome.shell favorite-apps 2>/dev/null) || exit 0
case "$cur" in
    *"$ID"*) ;;
    "[]"|"@as []") gsettings set org.gnome.shell favorite-apps "['$ID']" ;;
    *) gsettings set org.gnome.shell favorite-apps "$(printf '%s' "$cur" | sed "s/^\[/['$ID', /")" ;;
esac
exit 0
