#!/bin/sh
# Live session only: replace whatever installer icon(s) the Calamares package
# puts on the desktop with one clean "Install EmberOS" icon that runs the same
# command. Debian's icon can show up a little after login, so keep sweeping for
# a minute. Installed systems have no "boot=live" on their kernel command line,
# so they never get an installer icon.
grep -qw 'boot=live' /proc/cmdline || exit 0

DESK="$HOME/Desktop"
OURS="$DESK/install-emberos.desktop"
mkdir -p "$DESK"

# Remove every installer launcher that is not ours.
sweep() {
    for f in "$DESK"/*.desktop; do
        [ -f "$f" ] || continue
        [ "$f" = "$OURS" ] && continue
        if grep -qiE '^Name(\[[^]]*\])?=.*install' "$f"; then
            rm -f "$f"
        fi
    done
}

sweep

cat > "$OURS" <<EOF
[Desktop Entry]
Type=Application
Name=Install EmberOS
Comment=Install EmberOS to your computer
Exec=sudo -E calamares
Icon=/usr/share/pixmaps/emberos-install.png
Terminal=false
Categories=System;
StartupNotify=true
EOF
chmod +x "$OURS"

i=0
while [ "$i" -lt 30 ]; do
    sleep 2
    sweep
    i=$((i + 1))
done
exit 0
