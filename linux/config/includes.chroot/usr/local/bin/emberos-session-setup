#!/bin/sh
# Runs once for every user, at their first login: pin the everyday apps in the
# Budgie taskbar. In the live session it also creates an "Install EmberOS"
# launcher and pins it first (installed systems have no "boot=live" on their
# kernel command line, so they never get it).
MARK="$HOME/.config/emberos/session-setup-done"
[ -e "$MARK" ] && exit 0

pins="'firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.TextEditor.desktop', 'emberos-wallpaper.desktop'"

if grep -qw 'boot=live' /proc/cmdline; then
    APPS="$HOME/.local/share/applications"
    mkdir -p "$APPS"
    cat > "$APPS/install-emberos.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Install EmberOS
Comment=Install EmberOS to your computer
Exec=sudo -E calamares
Icon=/usr/share/pixmaps/emberos-install.png
Terminal=false
Categories=System;
StartupNotify=true
EOF
    pins="'install-emberos.desktop', $pins"
fi

# The panel creates its applets a few seconds after login: wait for the taskbar.
base=/com/solus-project/budgie-panel/applets/
i=0
while [ "$i" -lt 30 ]; do
    for u in $(dconf list "$base" 2>/dev/null | tr -d '/'); do
        if [ "$(dconf read "$base$u/name" 2>/dev/null)" = "'Icon Task List'" ]; then
            # the applet keeps its own settings under the applet's path
            dconf write "$base$u/settings/pinned-launchers" "[$pins]"
            dconf write "$base$u/pinned-launchers" "[$pins]"
            mkdir -p "$(dirname "$MARK")"
            touch "$MARK"
            exit 0
        fi
    done
    sleep 2
    i=$((i + 1))
done
exit 0
